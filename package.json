{
  "name": "gomoku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "native:build": "node scripts/build-native.js",
    "native:check": "node scripts/build-native.js && node scripts/check-native-engine.js",
    "external:match": "node scripts/external-match.js",
    "external:analyze": "node scripts/external-match/analyze.js",
    "external:compare": "node scripts/external-match/compare.js",
    "selfplay": "node scripts/selfplay.js",
    "selfplay:batch": "node scripts/selfplay/batch.js",
    "nnue:match-report": "node scripts/nnue-match-report.js",
    "nnue:relabel": "node scripts/relabel-dataset.js",
    "selfplay:export": "node scripts/export-dataset.js",
    "nnue:train": "node scripts/run-nnue.js train",
    "nnue:wasm-check": "node scripts/run-nnue.js check_wasm",
    "nnue:test": "node scripts/run-nnue.js test",
    "nnue:benchmark": "node scripts/run-nnue.js benchmark",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "wasm:build": "node scripts/build-wasm.js",
    "wasm:check": "npm run wasm:build && node scripts/check-wasm-parity.js && node scripts/check-wasm-state.js && node scripts/check-wasm-moves.js && node scripts/check-wasm-search.js && node scripts/check-wasm-root.js",
    "rust:test": "cargo test --locked --manifest-path engine-rust/Cargo.toml",
    "wasm:benchmark": "npm run wasm:build && node scripts/benchmark-wasm-search.js && node scripts/benchmark-wasm-root.js",
    "predev": "node scripts/check-wasm-artifact.js",
    "prebuild": "node scripts/check-wasm-artifact.js",
    "wasm:profile": "npm run wasm:build && node scripts/profile-wasm-search.js",
    "wasm:compare": "npm run wasm:build && node scripts/compare-wasm-search.js"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
